    "import os\n",
    "print(os.listdir('/kaggle/input'))\n",
    "for root, dirs, files in os.walk('/kaggle/input'):\n",
    "    level = root.replace('/kaggle/input', '').count(os.sep)\n",
    "    if level > 2:\n",
    "        continue\n",
    "    print(root, dirs, files[:5])\n"
   ]
