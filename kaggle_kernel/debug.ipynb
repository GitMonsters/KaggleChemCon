   "source": [
    "import os\n",
    "for root, dirs, files in os.walk('/kaggle/input'):\n",
    "    for d in dirs:\n",
    "        print(os.path.join(root,d))\n",
    "    for f in files[:5]:\n",
    "        print(os.path.join(root,f))\n",
    "    break\n",
    "print('---')\n",
    "try:\n",
    "    print(os.listdir('/kaggle/input'))\n",
    "except Exception as e:\n",
    "    print(e)\n"
   ]
  }
